NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CONNECT_MONGO=false

# FHIR R4 repository (local HAPI). FHIR_MODE=auto|hapi|embedded
FHIR_MODE=auto
FHIR_SERVER_URL=http://localhost:8080/fhir
FHIR_PUBLIC_URL=http://localhost:8080/fhir
FHIR_POSTGRES_URL=postgres://hapi:hapipass@localhost:5432/hapi

# SMART / OAuth
SMART_CLIENT_ID=carelink-patient-access
SMART_CLIENT_SECRET=carelink-smart-secret
SMART_REDIRECT_URI=http://localhost:5173/smart/callback

JWT_SECRET=carelink-dev-jwt-secret-change-me
JWT_EXPIRES_IN=24h

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
